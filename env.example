# .env.example — required environment variables for hatice operations
#
# Copy this file to .env and fill in real values, OR set these as system
# environment variables. The .env file is gitignored; never commit real secrets.
#
# See docs/operations/hatice-config.md for full operational context.

# ── Anthropic ──────────────────────────────────────────────────────────────────
# Claude API key used by dispatched agent sessions.
# Confirmed set as system env var (2026-05-13).
ANTHROPIC_API_KEY=sk-ant-...

# ── Linear ────────────────────────────────────────────────────────────────────
# Linear personal API token for reading issues, posting comments, and
# transitioning workflow states.
LINEAR_API_KEY=lin_api_...

# ── GitHub ────────────────────────────────────────────────────────────────────
# GitHub personal access token (or fine-grained PAT) with repo write scope.
# Used by dispatched workspaces to push branches and open PRs.
GH_TOKEN=ghp_...

# ── Optional / tunable ────────────────────────────────────────────────────────
# Override the default model (claude-sonnet-4-6).
# Set to claude-opus-4-6 for complex/orchestration issues.
# HATICE_MODEL=claude-sonnet-4-6

# Hard per-session cost cap in USD. Agents halt when this is reached.
# HATICE_COST_CAP_USD=3.00

# Daily cost envelope in USD across all parallel sessions.
# HATICE_DAILY_CAP_USD=30.00

# Maximum concurrent agent sessions.
# HATICE_MAX_CONCURRENT=3

# Maximum turns per agent session.
# HATICE_MAX_TURNS=30

# SSE dashboard port (localhost only).
# HATICE_DASHBOARD_PORT=4000

# Directory for per-session NDJSON logs.
# HATICE_LOG_DIR=~/workspaces/verk-v2/logs

# Workspace root for dispatched agent clones.
# HATICE_WORKSPACE_ROOT=~/workspaces/verk-v2

# Age threshold (days) after which stale workspaces are cleaned up.
# HATICE_WORKSPACE_MAX_AGE_DAYS=7
